{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.services.portail;
  sortedApps = lib.sort (a: b: a.name < b.name) cfg.apps;
  # The public /apps.json must never leak the `oidc` sub-object (paths, scopes).
  appsFile = pkgs.writeText "portail-apps.json" (
    builtins.toJSON (
      map (a: {
        inherit (a)
          name
          url
          description
          icon
          ;
      }) sortedApps
    )
  );
  oidcClients = map (
    a:
    let
      id = if a.oidc.clientId != "" then a.oidc.clientId else lib.strings.toLower a.name;
    in
    {
      inherit id;
      enabled = a.oidc.enable;
      public = a.oidc.public;
      redirectUris = a.oidc.redirectUris;
      scopes = a.oidc.scopes;
      user = a.oidc.user;
      group = a.oidc.group;
      generated = a.oidc.secretFile == null;
      # Value of `secret_file` in the generated config (`oidc_clients`): a generated name
      # in secretsDir, or the absolute path of a secret-manager-provided file.
      secretRef = if a.oidc.secretFile != null then toString a.oidc.secretFile else "${id}_secret";
    }
  ) (lib.filter (a: a.oidc.enable) cfg.apps);
  # `{ "<clientId>": {"user": ..., "group": ...} }` of the apps declaring a
  # Linux owner for their generated secret — read by the backend `ensure()`,
  # which grants them read access through a POSIX ACL at every startup.
  clientOwners = builtins.listToAttrs (
    map (c: lib.nameValuePair c.id { inherit (c) user group; }) (
      lib.filter (c: c.user != "") oidcClients
    )
  );
  # Clients inlined into the generated config.toml (`oidc_clients`). The portal
  # client is always enabled (it could not log in otherwise); app clients are
  # enabled by `oidc.enable`. `secret_file` is omitted for public clients (null is not
  # valid TOML); secret files themselves are generated by the backend `ensure()`.
  oidcClientsList =  map (
    c:
    {
      inherit (c)
        id
        enabled
        ;
      redirect_uris = c.redirectUris;
      scopes = c.scopes;
    }
    // lib.optionalAttrs (!c.public) {
      secret_file = c.secretRef;
    }
  ) oidcClients;
  tomlFormat = pkgs.formats.toml { };
  portailConfigFile = tomlFormat.generate "portail-config.toml" (
    {
      app_url = cfg.appUrl;
      bind_addr = cfg.bindAddress;
      ldap_url = cfg.ldap.url;
      ldap_base_dn = cfg.ldap.baseDn;
      ldap_people_ou = cfg.ldap.peopleOu;
      ldap_groups_ou = cfg.ldap.groupsOu;
      ldap_admin_pw_file = toString cfg.ldap.adminPasswordFile;
      oidc_issuer_url = cfg.appUrl;
      oidc_client_id = cfg.oidcClientId;
      oidc_redirect_uri = "${cfg.appUrl}/callback";
      oidc_secrets_dir = cfg.oidc.secretsDir;
      oidc_secret_logs = cfg.oidc.logSecretEvents;
      # String holding JSON — the backend re-parses it with serde_json.
      oidc_client_owners = builtins.toJSON clientOwners;
      oidc_clients = oidcClientsList;
    }
    // lib.optionalAttrs (cfg.ldap.caCertificateFile != null) {
      ldap_tls_ca = toString cfg.ldap.caCertificateFile;
    }
  );
in
{
  options.services.portail = {
    enable = lib.mkEnableOption "Portail backend (Rust axum, embedded OIDC provider) — frontend (nginx vhost) and OpenLDAP must be provisioned outside this module.";

    package = lib.mkOption {
      type = lib.types.package;
      description = "Backend (flake `packages.portail-backend`).";
    };

    appUrl = lib.mkOption {
      type = lib.types.str;
      description = "Public URL of the portal — also the OIDC issuer (the backend is its own provider). APP_URL, OIDC_ISSUER_URL, and redirect URI = appUrl + /callback. Used to bake VITE_* into `lib.mkFrontend` for the nginx vhost root.";
      example = "http://portail.nas.local";
    };

    lang = lib.mkOption {
      type = lib.types.str;
      default = "en";
      description = "Default UI language baked into the frontend build as `VITE_APP_LANG` — `fr` or `en`.";
    };

    bindAddress = lib.mkOption {
      type = lib.types.str;
      default = "127.0.0.1:3000";
      description = "Backend listen address (BIND_ADDR). In prod, 127.0.0.1 behind nginx.";
    };

    oidcClientId = lib.mkOption {
      type = lib.types.str;
      default = "portail";
      description = "OIDC client_id used by the backend (the portal is a client of its own provider). Written **enabled** into the generated `config.toml` (`oidc_clients`) at activation; its secret is generated on first start in `<client_id>_secret`.";
    };

    ldap = {
      url = lib.mkOption {
        type = lib.types.str;
        default = "ldap://127.0.0.1";
        description = "Existing LDAP server URL (LDAP_URL) — slapd must be provisioned outside this module.";
      };

      baseDn = lib.mkOption {
        type = lib.types.str;
        default = "dc=example,dc=com";
        description = "LDAP suffix (LDAP_BASE_DN).";
      };

      peopleOu = lib.mkOption {
        type = lib.types.str;
        default = "people";
        description = "OU holding user entries (LDAP_PEOPLE_OU).";
      };

      groupsOu = lib.mkOption {
        type = lib.types.str;
        default = "groups";
        description = "OU holding group entries (LDAP_GROUPS_OU).";
      };

      caCertificateFile = lib.mkOption {
        type = with lib.types; nullOr path;
        default = null;
        description = ''
          PEM CA bundle (e.g. `homeCA.crt`) validating the `ldaps://` endpoint.
          Passed to the backend as `SSL_CERT_FILE` — leave null when the
          serving certificate is publicly trusted.
        '';
      };

      adminPasswordFile = lib.mkOption {
        type = lib.types.path;
        description = ''
          File containing the `cn=admin,<baseDn>` password.
          Used by slapd (olcRootPW) and by the backend via `LDAP_ADMIN_PW` = path (read at startup). Secrets: agenix/sops-nix.
        '';
      };
    };

    oidc = {
      secretsDir = lib.mkOption {
        type = lib.types.str;
        default = "/var/lib/portail/oidc";
        description = ''
          Directory holding the OIDC secrets (mode 0700, owned by `portail`,
          plus per-client owner traverse ACLs).
          Clients are declared in the generated `config.toml` (`oidc_clients`),
          never in this directory: it only holds secret files. The backend
          generates the RSA signing key and every missing `secret_file`
          (0600, never overwritten once non-empty — an empty file is
          regenerated) on first start. A client exists and is
          activated by `oidc.enable = true` on the app (rewritten at every
          `nixos-rebuild` + service restart).
        '';
      };

      logSecretEvents = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = ''
          INFO-log every OIDC secret file action (generation, keep-as-is, ACL grants).
          Written as `oidc_secret_logs` in the generated config.toml; `false`
          silences the INFO lines (errors stay logged).
        '';
      };
    };

    vhost = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = "Create an nginx virtualhost serving the frontend build and proxying `/api` to the backend.";
      };

      hostName = lib.mkOption {
        type = lib.types.str;
        description = "nginx server_name (and TLS certificate CN).";
        example = "portail.nas.local";
      };

      forceSSL = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = "Redirect HTTP to HTTPS and serve TLS (does not impact ACME conflicts).";
      };

      sslCertificate = lib.mkOption {
        type = lib.types.path;
        description = "TLS full-chain certificate file (required when `forceSSL = true`).";
      };

      sslCertificateKey = lib.mkOption {
        type = lib.types.path;
        description = "TLS private key file (required when `forceSSL = true`).";
      };
    };

    apps = lib.mkOption {
      type =
        with lib.types;
        listOf (submodule {
          options = {
            name = lib.mkOption {
              type = lib.types.str;
              description = "Display name of the application.";
            };
            url = lib.mkOption {
              type = lib.types.str;
              description = "Absolute application URL (http or https).";
            };
            description = lib.mkOption {
              type = lib.types.str;
              default = "";
              description = "Short description shown under the link.";
            };
            icon = lib.mkOption {
              type = with lib.types; nullOr str;
              default = null;
              description = "Icon URL, optional.";
            };
            oidc = lib.mkOption {
              type = lib.types.submodule {
                options = {
                  enable = lib.mkEnableOption "OIDC client registration for this app, enabled — the backend rejects authorization requests for apps without this flag. Nix owns the `enabled` value of the generated entry: it is rewritten on every `nixos-rebuild`, so manual config edits do not survive";
                  clientId = lib.mkOption {
                    type = lib.types.str;
                    default = "";
                    description = "client_id in `oidc_clients` — defaults to the lowercased app `name`.";
                  };
                  redirectUris = lib.mkOption {
                    type = with lib.types; listOf str;
                    default = [ ];
                    description = "Registered redirect_uris (exact match required by the provider).";
                  };
                  scopes = lib.mkOption {
                    type = with lib.types; listOf str;
                    default = [
                      "openid"
                      "profile"
                      "email"
                      "groups"
                    ];
                    description = "Scopes granted to this client.";
                  };
                  public = lib.mkOption {
                    type = lib.types.bool;
                    default = false;
                    description = "Public client: no `secret_file` in `oidc_clients`, PKCE mandatory.";
                  };
                  secretFile = lib.mkOption {
                    type = with lib.types; nullOr path;
                    default = null;
                    description = ''
                      File holding the client secret (agenix/sops) — recorded as an absolute
                      `secret_file` in `oidc_clients`; the secret file is read by the backend on every token request.
                      When null and `public = false`, the backend generates the secret on first
                      start in `oidc.secretsDir/<client_id>_secret` (0600, never overwritten once
                      non-empty; an empty file is regenerated).
                      A provided file must be readable by the `portail` user.
                    '';
                  };
                  user = lib.mkOption {
                    type = lib.types.str;
                    default = "";
                    description = ''
                      Linux user given read access (POSIX ACL) to the generated `<client_id>_secret`
                      file and traverse access on `oidc.secretsDir`. Empty (default) = nobody but `portail` can read it. The backend
                      re-applies the ACL at every startup — no capabilities needed since it owns
                      the generated files. Requires `group`, `public = false` and no `secretFile`.
                    '';
                  };
                  group = lib.mkOption {
                    type = lib.types.str;
                    default = "";
                    description = "Linux group given read access (POSIX ACL) to the generated `<client_id>_secret` file — set together with `user`.";
                  };
                };
              };
              default = { };
              description = "Optional `oidc` sub-object (disabled by default): registers the app as an OIDC client of the portal in the generated `config.toml` (`oidc_clients`) with `enabled: false` unless `oidc.enabled = true`. Entries removed from `apps` disappear at the next rebuild; generated `<clientId>_secret` files remain in `oidc.secretsDir`.";
            };
          };
        });
      default = [ ];
      description = "Applications listed on the portal home page — rendered statically into apps.json served at /apps.json by the nginx vhost (no backend involved).";
      example = [
        {
          name = "Nextcloud";
          url = "https://cloud.nas.local";
          description = "Files";
          icon = null;
        }
      ];
    };
  };
  config = lib.mkIf cfg.enable {
    assertions = [
      {
        assertion = lib.all (c: c.redirectUris != [ ]) oidcClients;
        message = "each services.portail.apps entry with oidc.enable = true needs non-empty oidc.redirectUris";
      }
      {
        assertion = lib.all (c: c.user == "" || (c.group != "" && !c.public && c.generated)) oidcClients;
        message = ''
          apps entries setting oidc.user need oidc.group, public = false and no oidc.secretFile
          (only the generated <client_id>_secret can be ACL-granted).
        '';
      }
      {
        assertion = lib.all (c: c.group == "" || c.user != "") oidcClients;
        message = "apps entries setting oidc.group must also set oidc.user";
      }
    ];

    systemd.services.portail-backend = lib.mkMerge [
      {
        description = "Portail backend (Rust axum)";
        wantedBy = [ "multi-user.target" ];
        after = [ "network.target" ];
        serviceConfig = {
          ExecStart = "${cfg.package}/bin/portail-backend --config ${portailConfigFile}";
          User = "portail";
          Group = "portail";
          StateDirectory = "portail";
          Restart = "on-failure";
          RestartSec = "60s";
        };
      }
    ];

    users.users.portail = {
      description = "Portail backend service user";
      group = "portail";
      isSystemUser = true;
    };
    users.groups.portail = { };

    services.nginx = lib.mkIf cfg.vhost.enable {
      enable = true;
      recommendedProxySettings = true;
      virtualHosts.${cfg.vhost.hostName} = lib.mkMerge [
        {
          root = (pkgs.callPackage ../nix/frontend.nix { }) {
            appUrl = cfg.appUrl;
            oidcIssuerUrl = cfg.appUrl;
            oidcRedirectUri = "${cfg.appUrl}/callback";
            appLang = cfg.lang;
          };
          locations."/".index = "index.html";
          locations."/".tryFiles = "$uri /index.html";
          locations."= /apps.json".alias = toString appsFile;
          locations."/api".proxyPass = "http://${cfg.bindAddress}";
          locations."= /jwks.json".proxyPass = "http://${cfg.bindAddress}";
          locations."= /.well-known/openid-configuration".proxyPass = "http://${cfg.bindAddress}";
          locations."= /logout".proxyPass = "http://${cfg.bindAddress}";
        }
        (lib.mkIf cfg.vhost.forceSSL {
          forceSSL = true;
          sslCertificate = cfg.vhost.sslCertificate;
          sslCertificateKey = cfg.vhost.sslCertificateKey;
        })
      ];
    };
  };
}
