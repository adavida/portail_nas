objectclass ( 1.3.6.1.4.1.99999.2.1
    NAME 'portailUser'
    DESC 'Auxiliary class carrying portal custom attributes'
    SUP top AUXILIARY
    MAY ( portailAttr $ city $ age $ contact $ telephone $ pronom ) )
